programa {
  funcao inicio() {
    
        caractere letra

        escreva("Digite a letra da cor: ")
        leia(letra)

        escolha (t.caixa_alta(letra))
        {
            caso 'Z':
                escreva("Blue")
                pare

            caso 'V':
                escreva("Red")
                pare

            caso 'A':
                escreva("Yellow")
                pare

            caso contrario:
                escreva("Cor inválida")
        }
    }
}
  