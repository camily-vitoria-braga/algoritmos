programa {
  funcao inicio() {
   cadeia nome
   inteiro nivelPoder 
   real velocidadeMaxima
   logico habilidadeVoo

   nome = "Homem de Ferro"
   nivelPoder = 95
   velocidadeMaxima = 1200.0
   habilidadeVoo = verdadeiro

   escreva("Nome: " , nome, "\n")
   escreva("Nível de Poder: ", nivelPoder, "\n")
   escreva("Velocidade Maxima: ", velocidadeMaxima, "\n")
   escreva("Habilidade de Voo: ", habilidadeVoo)
  }
}
