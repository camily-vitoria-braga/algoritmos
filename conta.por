programa {
  funcao inicio() {
 
        real conta, valorCada
        inteiro amigos

        escreva("Valor total da conta: ")
        leia(conta)

        escreva("Quantidade de amigos: ")
        leia(amigos)

        valorCada = conta / amigos

        escreva("Cada amigo pagará R$ ", valorCada)
    }
}
  