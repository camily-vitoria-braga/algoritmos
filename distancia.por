programa {
  funcao inicio() {
 
        real distancia, litros, consumo

        escreva("Distância percorrida (km): ")
        leia(distancia)

        escreva("Litros gastos: ")
        leia(litros)

        consumo = distancia / litros

        escreva("Consumo médio: ", consumo, " km/l")
    }
}
 